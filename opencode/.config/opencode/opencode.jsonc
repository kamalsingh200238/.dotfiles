{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "ask",
      "~/personal/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git push --force-with-lease*": "ask",
      "git push --delete*": "ask",
      "git push *--delete*": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git clean -fdx*": "ask",
      "git clean -f *": "ask",
      "git branch -D*": "ask",
      "git checkout -- *": "ask",
      "git checkout .*": "ask",
      "git restore --source*": "ask",
      "git filter-branch*": "ask",
      "git filter-repo*": "ask",
      "git update-ref -d*": "ask",
      "git reflog expire*": "ask",
      "git gc --prune*": "ask",
      "git tag -d*": "ask",
      "jj abandon*": "ask",
      "jj op abandon*": "ask",
      "jj op restore*": "ask",
      "jj op undo*": "ask",
      "jj git push --force*": "ask",
      "jj git push -f*": "ask",
      "jj git push --allow-new*": "ask",
      "jj git push --deleted*": "ask",
      "jj bookmark delete*": "ask",
      "jj bookmark forget*": "ask",
      "jj branch delete*": "ask",
      "jj branch forget*": "ask",
      "jj workspace forget*": "ask",
      "jj squash*": "ask",
      "jj split*": "ask",
      "jj restore*": "ask",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "dd *": "deny",
      "mkfs *": "deny",
      "mkfs.*": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "wget * | sh*": "deny",
      "wget * | bash*": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "halt *": "deny",
    },
    "webfetch": "allow",
    "doom_loop": "allow",
  },
  "plugin": [
    "opencode-rules@latest"
  ],
  "mcp": {
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    }
  },
}
