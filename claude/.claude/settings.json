{
  "permissions": {
    "allow": [
      "Edit",
      "Bash(ls *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(jj status *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj print *)",
      "Bash(jj new *)",
      "Bash(jj bookmark create *)",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-opus-4-7",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay -v 5 /Users/kamal.singh/.dotfiles/claude/.claude/rings/ring.mp3"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/afplay -v 5 /Users/kamal.singh/.dotfiles/claude/.claude/rings/ring.mp3"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "notion@claude-plugins-official": true
  },
  "outputStyle": "default",
  "effortLevel": "high"
}
