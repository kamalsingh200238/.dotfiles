{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__playwright",
      "mcp__playwright__*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(mkfs.*)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push --delete*)",
      "Bash(git push *--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fdx*)",
      "Bash(git clean -f *)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git restore --source*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(git reflog expire*)",
      "Bash(git gc --prune*)",
      "Bash(git tag -d*)",
      "Bash(jj abandon*)",
      "Bash(jj op abandon*)",
      "Bash(jj op restore*)",
      "Bash(jj op undo*)",
      "Bash(jj git push --force*)",
      "Bash(jj git push -f*)",
      "Bash(jj git push --allow-new*)",
      "Bash(jj git push --deleted*)",
      "Bash(jj bookmark delete*)",
      "Bash(jj bookmark forget*)",
      "Bash(jj branch delete*)",
      "Bash(jj branch forget*)",
      "Bash(jj workspace forget*)",
      "Bash(jj squash*)",
      "Bash(jj split*)",
      "Bash(jj rebase*)",
      "Bash(jj restore*)"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "outputStyle": "default",
  "effortLevel": "high"
}
